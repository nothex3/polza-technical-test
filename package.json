{
  "name": "polza-technical-test",
  "version": "1.0.0",
  "private": true,
  "description": "Импорт компаний из JSON/CSV в PostgreSQL и серверный каталог на Next.js.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:schema": "node --env-file=.env.local --import tsx scripts/run-sql.ts db/schema.sql",
    "import:pages": "node --env-file=.env.local --import tsx scripts/import-pages.ts",
    "import:review": "node --env-file=.env.local --import tsx scripts/import-review.ts",
    "check:db": "node --env-file=.env.local --import tsx scripts/check-db.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "next": "16.2.12",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.12",
    "tsx": "4.22.5",
    "typescript": "5.9.3"
  }
}
